<BoxContainer xmlns="https://spacestation14.io"
              xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
              Orientation="Vertical"
              HorizontalExpand="True">
    <RichTextLabel Name="RoleTitle"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   StyleClasses="LabelHeading"
                   Margin="0 10 0 5"
                   Access="Public"/>
    <RichTextLabel Name="RoleDetails"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0 5 0 5"
                   StyleClasses="LabelSubText"
                   Access="Public"/>
    <BoxContainer Name="ObjectivesContainer"
                  Orientation="Vertical"
                  Access="Public"/>
    <BoxContainer Name="BriefingContainer"
                  Access="Public"/>
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BorderColor="Gray" BorderThickness="1" PaddingTop="5" />
        </PanelContainer.PanelOverride>
    </PanelContainer>
</BoxContainer>
